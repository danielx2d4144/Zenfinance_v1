{
  "name": "zenfinance-subgraph",
  "version": "1.0.0",
  "description": "ZenFinance Protocol Subgraph",
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph build",
    "deploy": "graph deploy --node https://api.thegraph.com/deploy/ zenfinance/zenfinance-testnet",
