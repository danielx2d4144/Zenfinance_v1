{
  "name": "zenlend-contracts",
  "version": "1.0.0",
  "description": "ZenLend Smart Contracts",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:zenfinance": "hardhat run scripts/deploy-zenfinance.ts --network zenchainTestnet",
    "deploy:zenfinance:local": "hardhat run scripts/deploy-zenfinance.ts --network localhost",
    "update-oracle-prices": "hardhat run scripts/update-oracle-prices.ts --network zenchainTestnet",
    "update-oracle-prices:local": "hardhat run scripts/update-oracle-prices.ts --network localhost",
    "test-rpc": "ts-node scripts/test-rpc-connection.ts",
    "coverage": "hardhat coverage",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol'"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "^5.0.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "hardhat": "^2.19.0",
    "prettier": "^3.1.0",
    "prettier-plugin-solidity": "^1.2.0",
    "solhint": "^4.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
